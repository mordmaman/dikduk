---
import { getCollection, getEntry } from 'astro:content';
import LessonLayout from '@/layouts/LessonLayout.astro';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map((lesson) => ({
    params: { slug: lesson.slug },
    props: { lesson },
  }));
}

const { slug } = Astro.params;

// In dev mode, props might not be available, so fetch the lesson directly
let lesson = Astro.props.lesson;
if (!lesson && slug) {
  lesson = await getEntry('lessons', slug);
}

if (!lesson) {
  return Astro.redirect('/404');
}

const { Content } = await lesson.render();
---

<LessonLayout
  title={lesson.data.title}
  hebrewTitle={lesson.data.hebrewTitle}
  description={lesson.data.description}
  unit={lesson.data.unit}
  chapter={lesson.data.chapter}
  weingreenRef={lesson.data.weingreenRef}
  lessonId={lesson.slug}
>
  <Content />
</LessonLayout>
