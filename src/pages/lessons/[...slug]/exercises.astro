---
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import ExerciseLayout from '@/layouts/ExerciseLayout.astro';
import ExerciseContainer from '@/components/exercises/ExerciseContainer.svelte';
import type { Exercise } from '@/lib/types';

// Type for raw JSON import (difficulty is string, not union literal)
interface ExerciseSetRaw {
  lessonId: string;
  difficulty?: string;
  exercises: Exercise[];
}

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map((lesson: CollectionEntry<'lessons'>) => ({
    params: { slug: lesson.slug },
    props: { lesson },
  }));
}

interface Props {
  lesson: CollectionEntry<'lessons'>;
}

const { slug } = Astro.params;

// In dev mode, props might not be available, so fetch the lesson directly
let lesson: CollectionEntry<'lessons'> | undefined = Astro.props.lesson;
if (!lesson && slug) {
  lesson = await getEntry('lessons', slug);
}

if (!lesson) {
  return Astro.redirect('/404');
}

// Load exercises using Vite's glob import
const exerciseFiles = import.meta.glob<{ default: ExerciseSetRaw }>(
  '/src/content/exercises/**/*.json',
  { eager: true }
);

// Find the matching basic exercise file
const basicExercisePath = `/src/content/exercises/${lesson.slug}.json`;
let basicExercises: ExerciseSetRaw = { lessonId: lesson.slug, exercises: [] };

if (exerciseFiles[basicExercisePath]) {
  basicExercises = exerciseFiles[basicExercisePath].default;
}

// Find the matching advanced exercise file (if exists)
const advancedExercisePath = `/src/content/exercises/${lesson.slug}-advanced.json`;
let advancedExercises: ExerciseSetRaw | null = null;

if (exerciseFiles[advancedExercisePath]) {
  advancedExercises = exerciseFiles[advancedExercisePath].default;
}
---

<ExerciseLayout
  title="Exercises"
  lessonId={lesson.slug}
  lessonTitle={lesson.data.title}
>
  {basicExercises.exercises.length > 0 ? (
    <ExerciseContainer
      client:load
      basicExerciseSet={basicExercises}
      advancedExerciseSet={advancedExercises}
      lessonTitle={lesson.data.title}
    />
  ) : (
    <div class="text-center py-12">
      <p class="text-muted dark:text-muted-dark mb-4">
        Exercises for this lesson are coming soon.
      </p>
      <a
        href={`/lessons/${lesson.slug}`}
        class="text-primary dark:text-primary-light hover:underline"
      >
        Return to lesson
      </a>
    </div>
  )}
</ExerciseLayout>
