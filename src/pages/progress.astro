---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Card from '@/components/ui/Card.svelte';
import ProgressDashboard from '@/components/progress/ProgressDashboard.svelte';
import SignupPrompt from '@/components/auth/SignupPrompt.svelte';
---

<BaseLayout title="My Progress" description="Track your Biblical Hebrew learning progress">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8">
    <header class="mb-8">
      <h1 class="text-3xl font-bold text-text dark:text-text-dark mb-2">
        My Progress
      </h1>
      <p class="text-muted dark:text-muted-dark">
        Track your learning journey
      </p>
    </header>

    <SignupPrompt client:load context="dashboard" />

    <ProgressDashboard client:load />
  </div>
</BaseLayout>
