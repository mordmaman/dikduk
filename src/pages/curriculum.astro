---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Card from '@/components/ui/Card.svelte';
import Badge from '@/components/ui/Badge.svelte';
import LessonProgressIndicator from '@/components/curriculum/LessonProgressIndicator.svelte';
import { getUnitDisplayName } from '@/lib/utils';

// Get all lessons and group by unit
const lessons = await getCollection('lessons');

const units = [
  'foundations',
  'unit-1',
  'unit-2',
  'unit-3',
  'unit-4',
  'unit-5',
  'unit-6',
  'unit-7',
  'unit-8',
];

type LessonEntry = CollectionEntry<'lessons'>;

const unitLessons: { id: string; name: string; lessons: LessonEntry[] }[] = units.map((unitId) => ({
  id: unitId,
  name: getUnitDisplayName(unitId),
  lessons: lessons
    .filter((lesson: LessonEntry) => lesson.data.unit === unitId)
    .sort((a: LessonEntry, b: LessonEntry) => a.data.order - b.data.order),
}));
---

<BaseLayout title="Curriculum" description="Complete curriculum for learning Biblical Hebrew grammar">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8">
    <header class="mb-8">
      <h1 class="text-3xl font-bold text-text dark:text-text-dark mb-2">
        Curriculum
      </h1>
      <p class="text-muted dark:text-muted-dark">
        Based on Weingreen's "A Practical Grammar for Classical Hebrew"
      </p>
    </header>

    <div class="space-y-8">
      {unitLessons.map((unit) => (
        <section>
          <h2 class="text-xl font-semibold text-text dark:text-text-dark mb-4">
            {unit.name}
          </h2>

          {unit.lessons.length > 0 ? (
            <div class="space-y-3">
              {unit.lessons.map((lesson) => (
                <a href={`/lessons/${lesson.slug}`} class="block">
                  <Card client:load class="hover:border-primary dark:hover:border-primary-light transition-colors">
                    <div class="flex items-start justify-between gap-4">
                      <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2 mb-1">
                          <h3 class="font-medium text-text dark:text-text-dark">
                            {lesson.data.title}
                          </h3>
                          <span
                            lang="he"
                            dir="rtl"
                            class="font-hebrew text-lg text-hebrew dark:text-hebrew-dark"
                          >
                            {lesson.data.hebrewTitle}
                          </span>
                        </div>
                        <p class="text-sm text-muted dark:text-muted-dark line-clamp-2">
                          {lesson.data.description}
                        </p>
                        <div class="flex gap-2 mt-2">
                          <Badge client:load variant="neutral">
                            Chapter {lesson.data.chapter}
                          </Badge>
                          <Badge client:load variant="neutral">
                            {lesson.data.weingreenRef}
                          </Badge>
                        </div>
                      </div>
                      <div class="flex-shrink-0 flex items-center gap-2">
                        <LessonProgressIndicator client:load lessonId={lesson.slug} />
                        <svg
                          class="w-5 h-5 text-gray-400"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M9 5l7 7-7 7"
                          />
                        </svg>
                      </div>
                    </div>
                  </Card>
                </a>
              ))}
            </div>
          ) : (
            <Card client:load class="bg-gray-50 dark:bg-gray-800">
              <p class="text-muted dark:text-muted-dark text-center py-4">
                Coming soon
              </p>
            </Card>
          )}
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
