---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  lessonId: string;
  lessonTitle: string;
}

const { title, lessonId, lessonTitle } = Astro.props;
---

<BaseLayout title={`Exercises: ${lessonTitle}`} description={`Practice exercises for ${lessonTitle}`}>
  <div class="lesson-content py-8">
    <!-- Back to lesson link -->
    <div class="mb-6">
      <a
        href={`/lessons/${lessonId}`}
        class="inline-flex items-center text-primary dark:text-primary-light hover:underline"
      >
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back to lesson
      </a>
    </div>

    <header class="mb-8">
      <h1 class="text-2xl font-bold text-text dark:text-text-dark">
        {title}
      </h1>
      <p class="text-muted dark:text-muted-dark mt-2">
        Practice exercises for {lessonTitle}
      </p>
    </header>

    <slot />
  </div>
</BaseLayout>
